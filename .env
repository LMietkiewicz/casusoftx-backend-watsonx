# ----------------------------------------------------------------------------
# REQUIRED — always
# ----------------------------------------------------------------------------

# Which inference backend to use.
PROVIDER=...                       # ollama | watsonx

# Base URL of the inference backend.
#   ollama  ->  e.g. http://localhost:11434
#   watsonx ->  e.g. https://us-south.ml.cloud.ibm.com
INFERENCE_PROVIDER_BASE_URL=...


# ----------------------------------------------------------------------------
# REQUIRED — only when PROVIDER=watsonx
# ----------------------------------------------------------------------------

API_KEY=...
PROJECT_ID=...


# ----------------------------------------------------------------------------
# REVIEW — context window sizing (affects when full documents are fed whole)
# ----------------------------------------------------------------------------
# A single-document query whose text fits 80% of the active model's context
# window is fed to the model in full (no chunked retrieval). These set that
# window per model family. Defaults are GUESSES — set the real *served* values:
# watsonx commonly caps a model BELOW its native window, so verify against your
# deployment rather than copying the spec sheet. Too high = oversized prompts /
# truncation; too low = the full-document path rarely fires.
# QWEN_CONTEXT_WINDOW=32768              # used when MODEL contains "qwen"
# LLAMA_CONTEXT_WINDOW=8192              # used when MODEL contains "llama"
# UNKNOWN_CONTEXT_BUDGET=10000           # flat budget when the model is neither


# ----------------------------------------------------------------------------
# INFRASTRUCTURE — review for your deployment (defaults may not match)
# ----------------------------------------------------------------------------

# Milvus vector database host. Default "localhost" suits local dev; in
# docker-compose this is usually the service name.
MILVUS_HOST=localhost

# Gotenberg sidecar (office formats -> PDF). Default "http://gotenberg:3000"
# works when Gotenberg runs as a compose service named "gotenberg".
GOTENBERG_URL=http://gotenberg:3000

# These have working defaults — uncomment only to change them.
# MILVUS_PORT=19530
# MILVUS_COLLECTION=file_embeddings
# GOTENBERG_TIMEOUT=60
# PORT=5000


# ----------------------------------------------------------------------------
# OPTIONAL — sane defaults in code; uncomment a line only to override it
# ----------------------------------------------------------------------------

# Inference connection.
# INFERENCE_PROVIDER_SSL_VERIFY=true     # disable only for trusted self-signed hosts
# LLM_REQUEST_TIMEOUT=120                # seconds

# RAG retrieval & reranking.
# A wide candidate pool is pulled from hybrid search, re-scored by a Polish
# cross-encoder, and the best few are kept. Reranking is the precision stage;
# hybrid search is the recall stage. Widening candidates raises the recall
# ceiling the reranker can realize.
# RERANK_ENABLED=true                    # set false to skip the cross-encoder entirely
# RERANKER_MODEL=sdadas/polish-reranker-roberta-v3
# RERANK_CANDIDATES=50                   # pulled from hybrid search before reranking
# RERANK_TOP_K=10                        # kept after reranking, passed to the LLM
# QUERY_PREFIX="zapytanie: "             # mmlw-retrieval dense-query prefix; model-specific,
#                                        # applied to the dense query only (not BM25/passages)

# Structured-output resolution cascade (schema -> coerce -> repair -> manual).
# STRUCTURED_MAX_REPAIRS=1               # repair attempts before "Do ręcznej weryfikacji"; 0 disables
# COERCION_THRESHOLD=0.80                # min normalized similarity to snap a near-miss to an allowed value
# COERCION_TIE_EPSILON=0.02              # candidates within this of the best count as an ambiguous tie

# Summarization budgets (quality knob — kept below model context).
# SUMMARY_TOKEN_BUDGET_OLLAMA=3000
# SUMMARY_TOKEN_BUDGET_WATSONX=20000
# CHARS_PER_TOKEN=3.5                    # token<->char heuristic; lower = more conservative (Polish ~3.5)

# Ingestion admission control (backpressure: 503 over the cap).
# MAX_PENDING_DOCS=500
# RETRY_AFTER_SECONDS=10                 # advertised in the Retry-After header on the 503

# Upload size cap, in bytes (default 50 MiB).
# MAX_CONTENT_LENGTH=52428800

# Result callbacks.
# CALLBACK_TIMEOUT=10                    # seconds
# CALLBACK_MAX_RETRIES=3
# CALLBACK_RETRY_BACKOFF=1.0             # base seconds, grows linearly per attempt

# Milvus internals (rarely changed).
# PARENT_ID_MULTIPLIER=100000           # also the hard cap on parent chunks per document


# ----------------------------------------------------------------------------
# DEBUG — keep OFF in production
# ----------------------------------------------------------------------------
# Debug logging writes confidential document content and raw LLM I/O to the
# logs. For that reason DEBUG=true REQUIRES ACKNOWLEDGE_SENSITIVE_LOGGING=true —
# set both together or startup fails by design.
#DEBUG=false
#ACKNOWLEDGE_SENSITIVE_LOGGING=false
# LOG_LEVEL=INFO                         # defaults to DEBUG when DEBUG=true, else INFO
# DEBUG_PREVIEW_CHARS=2000               # truncation length for previewed content in debug logs
